#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

// 最大支持的卷积核尺寸（K*K），可根据需要调整
#define MAX_K2 1024

// 前向声明
__mlu_entry__ void standard_conv2d_kernel(
    float *x, float *weight, float *bias, float *output,
    int N, int C, int OC, int H, int W,
    int K, int stride, int padding, int dilation, int groups,
    int H_out, int W_out);

// ---------- 包装函数 ----------
torch::Tensor bang_func(torch::Tensor x,
                        torch::Tensor kernel,
                        int in_channels,
                        int out_channels,
                        int kernel_size,
                        int stride,
                        int padding,
                        int dilation,
                        int groups,
                        bool bias) {
    auto x_contig = x.contiguous().to(torch::kFloat32);
    auto k_contig = kernel.contiguous().to(torch::kFloat32);

    TORCH_CHECK(x_contig.dim() == 4, "x must be 4-D (N, C, H, W)");
    TORCH_CHECK(k_contig.dim() == 4, "kernel must be 4-D (OC, C/groups, K, K)");

    const int N  = x_contig.size(0);
    const int C  = x_contig.size(1);
    const int H  = x_contig.size(2);
    const int W  = x_contig.size(3);
    const int OC = k_contig.size(0);
    const int K  = k_contig.size(2);

    TORCH_CHECK(C == in_channels, "in_channels mismatch");
    TORCH_CHECK(OC == out_channels, "out_channels mismatch");
    TORCH_CHECK(K == kernel_size, "kernel_size mismatch");
    TORCH_CHECK(C % groups == 0, "in_channels must be divisible by groups");
    TORCH_CHECK(OC % groups == 0, "out_channels must be divisible by groups");
    TORCH_CHECK(k_contig.size(1) == C / groups,
                "kernel shape[1] must equal in_channels/groups");

    int eff_K = dilation * (K - 1) + 1;
    int H_out = (H + 2 * padding - eff_K) / stride + 1;
    int W_out = (W + 2 * padding - eff_K) / stride + 1;
    TORCH_CHECK(H_out > 0 && W_out > 0, "Invalid output dimensions");

    auto output = torch::empty({N, OC, H_out, W_out}, x_contig.options());

    // 偏置处理：如果 bias 为 true，创建全零偏置并传入核函数
    torch::Tensor bias_tensor;
    float *bias_ptr = nullptr;
    if (bias) {
        bias_tensor = torch::zeros({OC}, x_contig.options());
        bias_ptr = bias_tensor.data_ptr<float>();
    }

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid_dim = {16, 1, 1};

    standard_conv2d_kernel<<<grid_dim, cnrtFuncTypeUnion1, queue>>>(
        x_contig.data_ptr<float>(),
        k_contig.data_ptr<float>(),
        bias_ptr,
        output.data_ptr<float>(),
        N, C, OC, H, W,
        K, stride, padding, dilation, groups,
        H_out, W_out
    );
    cnrtQueueSync(queue);

    return output;
}

// ---------- 标准2D卷积核函数 ----------
__mlu_entry__ void standard_conv2d_kernel(
    float *x, float *weight, float *bias, float *output,
    int N, int C, int OC, int H, int W,
    int K, int stride, int padding, int dilation, int groups,
    int H_out, int W_out) {

    uint32_t total_outs = (uint32_t)N * OC * H_out * W_out;
    uint32_t core_id    = taskId;
    uint32_t core_num   = taskDim;
    uint32_t per_core   = total_outs / core_num;
    uint32_t remainder  = total_outs % core_num;
    uint32_t start      = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t count      = per_core + (core_id < remainder ? 1 : 0);

    int K2 = K * K;
    int C_per_group = C / groups;
    int OC_per_group = OC / groups;

    // 所有用于 __memcpy 的变量必须显式声明为 __nram__
    __nram__ float in_buf[MAX_K2];
    __nram__ float w_buf[MAX_K2];
    __nram__ float accum;
    __nram__ float b_val;

    for (uint32_t idx = start; idx < start + count; ++idx) {
        // 解码输出坐标 (n, oc, oh, ow)
        int tmp = (int)idx;
        int ow  = tmp % W_out;  tmp /= W_out;
        int oh  = tmp % H_out;  tmp /= H_out;
        int oc  = tmp % OC;     tmp /= OC;
        int n   = tmp;

        accum = 0.0f;

        int group_id = oc / OC_per_group;
        int ic_start = group_id * C_per_group;
        int ic_end   = ic_start + C_per_group;

        int h_start = (int)oh * stride - padding;
        int w_start = (int)ow * stride - padding;

        // 遍历该组内的输入通道
        for (int ic = ic_start; ic < ic_end; ++ic) {
            // 1. 加载输入窗口（边界外自动填零）
            __bang_write_zero(in_buf, K2);
            for (int kh = 0; kh < K; ++kh) {
                int in_h = h_start + kh * dilation;
                if (in_h < 0 || in_h >= H) continue;
                for (int kw = 0; kw < K; ++kw) {
                    int in_w = w_start + kw * dilation;
                    if (in_w < 0 || in_w >= W) continue;
                    int x_off = ((n * C + ic) * H + in_h) * W + in_w;
                    __memcpy(in_buf + kh * K + kw, x + x_off, sizeof(float), GDRAM2NRAM);
                }
            }

            // 2. 加载对应权重 [oc, ic - ic_start, :, :]
            int w_off = (oc * C_per_group + (ic - ic_start)) * K2;
            __memcpy(w_buf, weight + w_off, K2 * sizeof(float), GDRAM2NRAM);

            // 3. 标量点乘累加
            for (int i = 0; i < K2; ++i) {
                accum += in_buf[i] * w_buf[i];
            }
        }

        // 加偏置
        if (bias != nullptr) {
            __memcpy(&b_val, bias + oc, sizeof(float), GDRAM2NRAM);
            accum += b_val;
        }

        // 写回全局内存
        __memcpy(output + idx, &accum, sizeof(float), NRAM2GDRAM);
    }
}