#include <bang.h>
#include <cnrt.h>
#include <torch/extension.h>
#include <c10/util/Half.h>

#define MAX_KERNEL 64   // 支持的最大 kernel_size，64 是 64 的倍数，便于对齐

__mlu_entry__ void avgpool2d_kernel(c10::Half *input, c10::Half *output) {
    uint32_t batch_per_core = 1024 / taskDim * 2048 * 2048;
    uint32_t start_batch = taskId * batch_per_core;

    // NRAM 空间：用于缓存一行数据和 reduce 输出
    __nram__ half nram_input[22528];
    __nram__ half nram_output[2046];
    float sum;   // 标量累加器（使用 float 保证精度）

    for (uint32_t i = 0; i < batch_per_core; i++) {
        for (uint32_t j = 0; j < 186; j++)
        {
            __memcpy(nram_input, input + start_batch + i * 2048 * 2048 + j * 11 * 2048, 22528 * sizeof(float), GDRAM2NRAM);
            __bang_sumpool(nram_output, nram_input, 1, 11, 2048, 11, 11, 11, 11);
            __bang_mul_scalar(nram_output, nram_output, (half)(1.0/121.0), 2048);
            __memcpy(output + i * 186 * 186 + j * 186, nram_output, 22528 * sizeof(float), NRAM2GDRAM);
        }
    }
}

torch::Tensor bang_func(torch::Tensor x, int kernel_size) {
    auto y = torch::empty({16, 64, 186, 186}, x.options());
    avgpool2d_kernel<<<(cnrtDim3_t){64, 1, 1}, cnrtFuncTypeUnion1, torch_mlu::getCurMLUStream()>>>(
        x.data_ptr<c10::Half>(),
        y.data_ptr<c10::Half>()
    );
    return y;
}