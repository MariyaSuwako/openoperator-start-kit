#include <bang.h>
#include <cnrt.h>
#include <torch/extension.h>
#include <c10/util/Half.h>

#define MAX_KERNEL 64   // 支持的最大 kernel_size，64 是 64 的倍数，便于对齐

__mlu_entry__ void avgpool2d_kernel(c10::Half *input, c10::Half *output) {
    uint32_t batch_per_core_in = 16 / taskDim * 64 * 2048 * 2048;
    uint32_t batch_per_core_out = 16 / taskDim * 64 * 186 * 186;
    uint32_t start_batch_in = taskId * batch_per_core_in;
    uint32_t start_batch_out = taskId * batch_per_core_out;

    __nram__ half nram_input[131072];
    __nram__ half nram_temp[11904];
    __nram__ half nram_output[11904];

    for (uint32_t i = 0; i < 186; i++)
    {
        __bang_write_zero(nram_output, 11904);
        for (uint32_t j = 0; j < 11; j++)
        {
            __memcpy(nram_input, input + start_batch_in + i * 11 * 2048 * 64 + j * 2048 * 64, 131072 * sizeof(half), GDRAM2NRAM);
            __bang_sumpool(nram_temp, nram_input, 64, 1, 2048, 1, 11, 11, 1);
            __bang_mul_scalar(nram_temp, nram_temp, (half)(1.0/121.0), 11904);
            __bang_add(nram_output, nram_output, nram_temp, 11904);
        }
        __memcpy(output + start_batch_out + i * 186 * 64, nram_output, 11904 * sizeof(half), NRAM2GDRAM);
    }
}

torch::Tensor bang_func(torch::Tensor x, int kernel_size) {
    x = x.permute({0, 2, 3, 1});
    auto y = torch::empty({16, 186, 186, 64}, x.options());
    avgpool2d_kernel<<<(cnrtDim3_t){16, 1, 1}, cnrtFuncTypeUnion1, torch_mlu::getCurMLUStream()>>>(
        x.data_ptr<c10::Half>(),
        y.data_ptr<c10::Half>()
    );
    return y.permute({0, 3, 1, 2});
}