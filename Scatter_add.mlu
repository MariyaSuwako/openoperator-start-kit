#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>


__mlu_entry__ void scatter_add_kernel(
    const float *src,
    const int *index,
    float *output,
    int N,
    int D,
    int dim_size) {
    int tid = taskId;
    int num_cores = taskDim;

    int chunk = (N + num_cores - 1) / num_cores;
    int start = tid * chunk;
    int end = start + chunk;
    if (end > N) {
        end = N;
    }

    __nram__ int dst_row_nram;
    __nram__ float src_val;
    __nram__ float dst_val;

    for (int i = start; i < end; ++i) {
        __memcpy(&dst_row_nram, index + i, sizeof(int), GDRAM2NRAM);
        int dst_row = dst_row_nram;
        if (dst_row < 0 || dst_row >= dim_size) {
            continue;
        }
        int src_base = i * D;
        int dst_base = dst_row * D;
        for (int j = 0; j < D; ++j) {
            __memcpy(&src_val, src + src_base + j, sizeof(float), GDRAM2NRAM);
            __memcpy(&dst_val, output + dst_base + j, sizeof(float), GDRAM2NRAM);
            dst_val += src_val;
            __memcpy(output + dst_base + j, &dst_val, sizeof(float), NRAM2GDRAM);
        }
    }
}

torch::Tensor bang_func(torch::Tensor src, torch::Tensor index, int dim_size) {
    TORCH_CHECK(src.dim() == 2, "src must be 2D [N, D]");
    TORCH_CHECK(index.dim() == 1, "index must be 1D [N]");
    TORCH_CHECK(src.size(0) == index.size(0), "src.size(0) must match index.size(0)");
    TORCH_CHECK(dim_size >= 0, "dim_size must be non-negative");

    auto src_contig = src.contiguous().to(torch::kFloat32);
    auto index_contig = index.contiguous().to(torch::kInt32);

    int N = src_contig.size(0);
    int D = src_contig.size(1);
    auto output = torch::zeros({dim_size, D}, src_contig.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid_dim = {1, 1, 1};

    scatter_add_kernel<<<grid_dim, cnrtFuncTypeUnion1, queue>>>(
        src_contig.data_ptr<float>(),
        index_contig.data_ptr<int>(),
        output.data_ptr<float>(),
        N,
        D,
        dim_size
    );
    cnrtQueueSync(queue);

    return output;
}
