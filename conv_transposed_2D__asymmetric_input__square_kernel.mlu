#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

// 输入平面 32768 (=128*256), 输出平面 33540 (=130*258)
#define MAX_PLANE 40960
#define MAX_K2 64

// ---------- 转置 2D 卷积核函数 (float32, 向量化散播) ----------
__mlu_entry__ void conv_transpose2d_kernel(
    float *x, float *weight, float *bias, float *output,
    int N, int C_in, int C_out, int H_in, int W_in,
    int K, int stride, int padding, int output_padding, int groups,
    int H_out, int W_out) {

    uint32_t total_pairs = (uint32_t)N * (uint32_t)C_out;
    uint32_t core_id  = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = total_pairs / core_num;
    uint32_t rem      = total_pairs % core_num;
    uint32_t start = core_id * per_core + (core_id < rem ? core_id : rem);
    uint32_t count = per_core + (core_id < rem ? 1 : 0);

    int C_in_per_group  = C_in / groups;
    int C_out_per_group = C_out / groups;
    int K2 = K * K;
    int x_plane   = H_in  * W_in;
    int out_plane = H_out * W_out;

    (void)output_padding;

    __nram__ float x_buf[MAX_PLANE];     // 输入平面
    __nram__ float out_buf[MAX_PLANE];   // 输出平面累加器
    __nram__ float tmp_buf[MAX_PLANE];   // 临时乘积
    __nram__ float w_buf[MAX_K2];
    __nram__ float b_val;

    for (uint32_t pair_idx = start; pair_idx < start + count; ++pair_idx) {
        int n  = (int)(pair_idx / (uint32_t)C_out);
        int oc = (int)(pair_idx % (uint32_t)C_out);

        int group_id = oc / C_out_per_group;
        int oc_local = oc % C_out_per_group;
        int ic_start = group_id * C_in_per_group;
        int ic_end   = ic_start + C_in_per_group;

        // 1. 清零输出累加器
        __bang_write_zero(out_buf, out_plane);

        // 2. 遍历该组 ic
        for (int ic = ic_start; ic < ic_end; ++ic) {
            // 加载输入平面
            int x_off_base = (n * C_in + ic) * x_plane;
            __memcpy(x_buf, x + x_off_base, x_plane * sizeof(float), GDRAM2NRAM);

            // 加载 K*K 权重
            int w_off_base = (ic * C_out_per_group + oc_local) * K2;
            __memcpy(w_buf, weight + w_off_base, K2 * sizeof(float), GDRAM2NRAM);

            // 散播
            for (int kh = 0; kh < K; ++kh) {
                for (int kw = 0; kw < K; ++kw) {
                    float wv = w_buf[kh * K + kw];

                    // 按行向量化：每行 W_in 元素
                    for (int iy = 0; iy < H_in; ++iy) {
                        int oy = iy * stride + kh - padding;
                        if (oy < 0 || oy >= H_out) continue;

                        // ox = ix*stride + kw - padding, ix in [0, W_in)
                        // stride=1 时 ox 连续；通用情况下找有效 ix 子区间
                        int ix_lo, ix_hi;
                        // ox >= 0  -> ix >= ceil((padding-kw)/stride)
                        int lo_num = padding - kw;
                        if (stride <= 0) { ix_lo = 0; ix_hi = 0; }
                        else {
                            ix_lo = (lo_num > 0) ? ((lo_num + stride - 1) / stride) : 0;
                            // ox < W_out -> ix < ceil((W_out+padding-kw)/stride) 但严格 <
                            // 等价 ix <= (W_out-1+padding-kw)/stride  (向下取整)
                            int hi_num = W_out - 1 + padding - kw;
                            ix_hi = (hi_num >= 0) ? (hi_num / stride + 1) : 0;
                            if (ix_hi > W_in) ix_hi = W_in;
                            if (ix_lo < 0) ix_lo = 0;
                        }
                        int n_valid = ix_hi - ix_lo;
                        if (n_valid <= 0) continue;

                        if (stride == 1) {
                            // ox = ix + kw - padding, 连续段
                            int ox_lo = ix_lo + kw - padding;
                            int src_off = iy * W_in + ix_lo;
                            int dst_off = oy * W_out + ox_lo;
                            // FMA: out += x * wv
                            __bang_mul_const(tmp_buf, x_buf + src_off, wv, n_valid);
                            __bang_add(out_buf + dst_off,
                                       out_buf + dst_off,
                                       tmp_buf, n_valid);
                        } else {
                            // stride>1: ox 非连续，标量回退
                            for (int ix = ix_lo; ix < ix_hi; ++ix) {
                                int ox = ix * stride + kw - padding;
                                out_buf[oy * W_out + ox] += x_buf[iy * W_in + ix] * wv;
                            }
                        }
                    }
                }
            }
        }

        // 3. 偏置
        if (bias != nullptr) {
            __memcpy(&b_val, bias + oc, sizeof(float), GDRAM2NRAM);
            float bf = b_val;
            for (int i = 0; i < out_plane; ++i) {
                out_buf[i] += bf;
            }
        }

        // 4. 写回
        int out_base = (n * C_out + oc) * out_plane;
        __memcpy(output + out_base, out_buf, out_plane * sizeof(float), NRAM2GDRAM);
    }
}

// ---------- 包装函数 ----------
torch::Tensor bang_func(torch::Tensor x,
                        torch::Tensor kernel,
                        int in_channels,
                        int out_channels,
                        int kernel_size,
                        int stride,
                        int padding,
                        int output_padding,
                        int groups,
                        bool bias) {
    auto x_contig = x.contiguous().to(torch::kFloat32);
    auto k_contig = kernel.contiguous().to(torch::kFloat32);

    TORCH_CHECK(x_contig.dim() == 4, "x must be 4-D (N, C_in, H, W)");
    TORCH_CHECK(k_contig.dim() == 4, "kernel must be 4-D (C_in, C_out/groups, K, K)");

    const int N    = x_contig.size(0);
    const int C_in = x_contig.size(1);
    const int H_in = x_contig.size(2);
    const int W_in = x_contig.size(3);
    const int K    = k_contig.size(2);
    const int C_out_from_kernel = k_contig.size(1) * groups;

    TORCH_CHECK(C_in == in_channels, "in_channels mismatch");
    TORCH_CHECK(K == kernel_size, "kernel_size mismatch");
    TORCH_CHECK(in_channels  % groups == 0, "in_channels must be divisible by groups");
    TORCH_CHECK(out_channels % groups == 0, "out_channels must be divisible by groups");
    TORCH_CHECK(C_out_from_kernel == out_channels, "out_channels mismatch with kernel shape");
    TORCH_CHECK(k_contig.size(0) == C_in, "kernel shape[0] must equal in_channels");
    TORCH_CHECK(k_contig.size(3) == K,   "kernel must be square");
    TORCH_CHECK(K * K <= MAX_K2, "kernel_size too large for current NRAM buffer");

    int H_out = (H_in - 1) * stride - 2 * padding + K + output_padding;
    int W_out = (W_in - 1) * stride - 2 * padding + K + output_padding;
    TORCH_CHECK(H_out > 0 && W_out > 0, "Invalid output dimensions");
    TORCH_CHECK(H_out * W_out <= MAX_PLANE && H_in * W_in <= MAX_PLANE,
                "plane too large for current NRAM buffer (MAX_PLANE)");

    auto output = torch::empty({N, out_channels, H_out, W_out}, x_contig.options());

    torch::Tensor bias_tensor;
    float *bias_ptr = nullptr;
    if (bias) {
        bias_tensor = torch::zeros({out_channels}, x_contig.options());
        bias_ptr = bias_tensor.data_ptr<float>();
    }

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid_dim = {16, 1, 1};

    conv_transpose2d_kernel<<<grid_dim, cnrtFuncTypeUnion1, queue>>>(
        x_contig.data_ptr<float>(),
        k_contig.data_ptr<float>(),
        bias_ptr,
        output.data_ptr<float>(),
        N, C_in, out_channels, H_in, W_in,
        K, stride, padding, output_padding, groups,
        H_out, W_out
    );

    return output;
}
