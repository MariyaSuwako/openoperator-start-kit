#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 256   // 分块读取，便于循环

__mlu_entry__ void gemv_kernel(
    float *A, float *B, float *C,
    int M, int K);

// ---------- 包装函数 ----------
torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    auto A_contig = A.contiguous().to(torch::kFloat32);
    auto B_contig = B.contiguous().to(torch::kFloat32);

    TORCH_CHECK(A_contig.dim() == 2, "A must be 2-D (M, K)");
    TORCH_CHECK(B_contig.dim() == 2, "B must be 2-D (K, 1)");

    int M = A_contig.size(0);
    int K = A_contig.size(1);
    TORCH_CHECK(B_contig.size(0) == K && B_contig.size(1) == 1,
                "B shape must be (K, 1)");

    auto C = torch::empty({M, 1}, A_contig.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid_dim = {16, 1, 1};

    gemv_kernel<<<grid_dim, cnrtFuncTypeUnion1, queue>>>(
        A_contig.data_ptr<float>(),
        B_contig.data_ptr<float>(),
        C.data_ptr<float>(),
        M, K
    );
    cnrtQueueSync(queue);
    return C;
}

// ---------- GEMV 核函数（标量累加，避免向量指令问题） ----------
__mlu_entry__ void gemv_kernel(float *A, float *B, float *C, int M, int K) {
    uint32_t total_rows = (uint32_t)M;
    uint32_t core_id   = taskId;
    uint32_t core_num  = taskDim;
    uint32_t per_core  = total_rows / core_num;
    uint32_t remainder = total_rows % core_num;
    uint32_t start_row = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t row_count  = per_core + (core_id < remainder ? 1 : 0);

    __nram__ float A_buf[CHUNK_SIZE];
    __nram__ float B_buf[CHUNK_SIZE];
    __nram__ float accum;

    for (uint32_t i = start_row; i < start_row + row_count; ++i) {
        accum = 0.0f;

        for (int k_off = 0; k_off < K; k_off += CHUNK_SIZE) {
            int len = (k_off + CHUNK_SIZE <= K) ? CHUNK_SIZE : (K - k_off);

            // 加载 A 行片段和 B 列片段
            __memcpy(A_buf, A + i * K + k_off, len * sizeof(float), GDRAM2NRAM);
            __memcpy(B_buf, B + k_off,       len * sizeof(float), GDRAM2NRAM);

            // 标量乘加（安全，无对齐要求）
            for (int j = 0; j < len; ++j) {
                accum += A_buf[j] * B_buf[j];
            }
        }

        // 写回结果
        __memcpy(C + i, &accum, sizeof(float), NRAM2GDRAM);
    }
}
