#include <bang.h>
#include <math.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 128  // NRAM 缓冲区大小

// MLU 核函数：逐元素计算 sqrt(abs(x))
__mlu_entry__ void abs_sqrt_kernel(const float* x, float* output, int n) {
    int task_id = taskId;
    int task_num = taskDim;
    int chunk = n / task_num;
    int start = task_id * chunk;
    int end = (task_id == task_num - 1) ? n : start + chunk;

    __nram__ float buf[CHUNK_SIZE];

    for (int i = start; i < end; i += CHUNK_SIZE) {
        int size = (end - i) < CHUNK_SIZE ? (end - i) : CHUNK_SIZE;
        // 从全局内存加载到 NRAM
        __memcpy(buf, x + i, size * sizeof(float), GDRAM2NRAM);
        // 标量循环：绝对值 + 平方根
        for (int j = 0; j < size; ++j) {
            float val = buf[j];
            val = (val >= 0) ? val : -val;
            buf[j] = sqrtf(val);
        }
        // 写回输出张量
        __memcpy(output + i, buf, size * sizeof(float), NRAM2GDRAM);
    }
}

// PyTorch 包装函数
torch::Tensor bang_func(torch::Tensor x) {
    // 确保输入为连续内存且数据类型为 float32
    auto x_contig = x.contiguous().to(torch::kFloat32);
    int total_elements = x_contig.numel();
    auto output = torch::empty_like(x_contig);

    // 配置计算核数（64 核，可根据数据量调整）
    cnrtDim3_t grid_dim = {64, 1, 1};
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    abs_sqrt_kernel<<<grid_dim, cnrtFuncTypeUnion1, queue>>>(
        x_contig.data_ptr<float>(),
        output.data_ptr<float>(),
        total_elements
    );
    cnrtQueueSync(queue);
    return output;
}
