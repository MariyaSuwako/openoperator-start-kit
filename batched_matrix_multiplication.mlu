#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>

#define CHUNK_SIZE_A 524288
#define CHUNK_SIZE_B 2097152
#define CHUNK_SIZE_C 1785856

__mlu_entry__ void leakyrelu_kernel(float *input_A, float *input_B, float *output, int total_A, int total_B, int total_C) {
    // 多核拆分参数
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core_A = total_A / core_num;
    uint32_t remainder_A = total_A % core_num;
    uint32_t per_core_B = total_B / core_num;
    uint32_t remainder_B = total_B % core_num;
    uint32_t per_core_C = total_C / core_num;
    uint32_t remainder_C = total_C % core_num;
    uint32_t start_A = core_id * per_core_A + (core_id < remainder_A ? core_id : remainder_A);
    uint32_t count_A = per_core_A + (core_id < remainder_A ? 1 : 0);
    uint32_t start_B = core_id * per_core_B + (core_id < remainder_B ? core_id : remainder_B);
    uint32_t count_B = per_core_B + (core_id < remainder_B ? 1 : 0);
    uint32_t start_C = core_id * per_core_C + (core_id < remainder_C ? core_id : remainder_C);
    uint32_t count_C = per_core_C + (core_id < remainder_C ? 1 : 0);

    // NRAM 空间分配
    __nram__ float nram_input[1024];
    __nram__ float nram_temp[2048];
    __nram__ float nram_output[2048];

    for (uint32_t offset_A = 0, offset_B = 0, offset_C = 0; offset_A < count_A || offset_B < count_B || offset_C < count_C; offset_A += CHUNK_SIZE_A, offset_B += CHUNK_SIZE_B, offset_C += CHUNK_SIZE_C) {
        uint32_t len_A = (offset_A + CHUNK_SIZE_A <= count_A) ? CHUNK_SIZE_A : (count_A - offset_A);
        uint32_t len_B = (offset_B + CHUNK_SIZE_B <= count_B) ? CHUNK_SIZE_B : (count_B - offset_B);
        uint32_t len_C = (offset_C + CHUNK_SIZE_C <= count_C) ? CHUNK_SIZE_C : (count_C - offset_C);
        for (int i=0;i<512;i++)
        {
            for (int j=0;j<1024;j++)
            {
                __memcpy(nram_input, input_B + start_B + offset_B + j * 2048, 2048 * sizeof(float), GDRAM2NRAM);
                __bang_mul_scalar(nram_temp, nram_input, *(input_A + start_A + offset_A + i * 1024 + j), 2048);
                __bang_atomic_reduce_add(output + start_C + offset_C + i * 2048, nram_temp, 2048);
            }
            //__memcpy(output + start_C + offset_C + i * 2048, nram_output, len_C * sizeof(float), NRAM2GDRAM);
        }
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    A = A.to(torch::kFloat32);
    B = B.to(torch::kFloat32);
    auto C = torch::empty({512, 2048});
    int total_A = A.numel(), total_B = B.numel(), total_C = B.numel();
    leakyrelu_kernel<<<(cnrtDim3_t){64, 1, 1}, cnrtFuncTypeUnion1, torch_mlu::getCurMLUStream()>>>(
        A.data_ptr<float>(),
        B.data_ptr<float>(),
        C.data_ptr<float>(),
        total_A,
        total_B,
        total_C
    );
    return C.to(torch::kFloat16);
}