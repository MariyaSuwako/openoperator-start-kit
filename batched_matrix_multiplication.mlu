#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>

#define CHUNK_SIZE_A 524288
#define CHUNK_SIZE_B 2097152
#define CHUNK_SIZE_C 1048576

__mlu_entry__ void leakyrelu_kernel(float *input_A, float *input_B, float *output) {
    // 多核拆分参数
    uint32_t count_A = 128 / taskDim * CHUNK_SIZE_A;
    uint32_t start_A = taskId * count_A;
    uint32_t count_B = 128 / taskDim * CHUNK_SIZE_B;
    uint32_t start_B = taskId * count_B;
    uint32_t count_C = 128 / taskDim * CHUNK_SIZE_C;
    uint32_t start_C = taskId * count_C;

    // NRAM 空间分配
    __nram__ float nram_input[2048];
    __nram__ float nram_temp[1024];
    __nram__ float nram_output[2048];
    for (uint32_t offset_A = 0, offset_B = 0, offset_C = 0; offset_A < count_A || offset_B < count_B || offset_C < count_C; offset_A += CHUNK_SIZE_A, offset_B += CHUNK_SIZE_B, offset_C += CHUNK_SIZE_C) {
        for (uint32_t i=0;i<512;i++)
        {
            __bang_write_zero(nram_output, 2048);
            __memcpy(nram_temp, input_A + start_A + offset_A + i * 1024, 1024 * sizeof(float), GDRAM2NRAM);
            for (uint32_t j=0;j<1024;j++)
            {
                __memcpy(nram_input, input_B + start_B + offset_B + j * 2048, 2048 * sizeof(float), GDRAM2NRAM);
                __bang_mul_scalar(nram_input, nram_input, nram_temp[j], 2048);
                __bang_add(nram_output, nram_input, nram_output, 2048);
            }
            __memcpy(output + start_C + offset_C + i * 2048, nram_output, 2048 * sizeof(float), NRAM2GDRAM);
        }
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    auto C = torch::empty_like(B).narrow(1,0,512);
    leakyrelu_kernel<<<(cnrtDim3_t){64, 1, 1}, cnrtFuncTypeUnion1, torch_mlu::getCurMLUStream()>>>(
        A.data_ptr<float>(),
        B.data_ptr<float>(),
        C.data_ptr<float>()
    );
    return C;
}