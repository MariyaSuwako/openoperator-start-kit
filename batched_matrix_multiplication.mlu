#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define M_TILE 128
#define K_TILE 256
#define N_TILE 256

__mlu_entry__ void bmm_kernel(
    half* A,
    half* B,
    half* C)
{
    int batch = taskId;

    if(batch >= 128)
        return;

    A += batch * 512 * 1024;
    B += batch * 1024 * 2048;
    C += batch * 512 * 2048;

    __nram__ half A_tile[M_TILE * K_TILE];
    __nram__ half B_tile[K_TILE * N_TILE];

    __nram__ float C_tile[M_TILE * N_TILE];

    for(int m0 = 0; m0 < 512; m0 += M_TILE)
    {
        for(int n0 = 0; n0 < 2048; n0 += N_TILE)
        {
            __bang_write_zero(
                C_tile,
                M_TILE * N_TILE * sizeof(float));

            for(int k0 = 0; k0 < 1024; k0 += K_TILE)
            {
                for(int i = 0; i < M_TILE; i++)
                {
                    __memcpy(
                        A_tile + i * K_TILE,
                        A + (m0+i)*1024 + k0,
                        K_TILE*sizeof(half),
                        GDRAM2NRAM);
                }

                for(int i = 0; i < K_TILE; i++)
                {
                    __memcpy(
                        B_tile + i*N_TILE,
                        B + (k0+i)*2048 + n0,
                        N_TILE*sizeof(half),
                        GDRAM2NRAM);
                }

                __bang_matmul(
                    C_tile,
                    A_tile,
                    B_tile,
                    M_TILE,
                    K_TILE,
                    N_TILE);
            }

            for(int i=0;i<M_TILE;i++)
            {
                __memcpy(
                    C + (m0+i)*2048 + n0,
                    ((half*)C_tile)+i*N_TILE,
                    N_TILE*sizeof(half),
                    NRAM2GDRAM);
            }
        }
    }
}