#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <vector>

torch::Tensor bang_func(torch::Tensor input, double threshold) {
    TORCH_CHECK(input.dim() == 2, "input must be 2D [M, N]");

    auto input_contig = input.contiguous().to(torch::kFloat32);
    const int64_t total = input_contig.numel();
    const float threshold_f = static_cast<float>(threshold);

    std::vector<float> input_host(total);
    cnrtMemcpy(input_host.data(),
               input_contig.data_ptr<float>(),
               total * sizeof(float),
               cnrtMemcpyDevToHost);

    int64_t selected_count = 0;
    for (int64_t i = 0; i < total; ++i) {
        if (input_host[i] > threshold_f) {
            ++selected_count;
        }
    }

    auto output = torch::empty({selected_count}, input_contig.options());
    if (selected_count == 0) {
        return output;
    }

    std::vector<float> output_host(selected_count);
    int64_t write_pos = 0;
    for (int64_t i = 0; i < total; ++i) {
        float value = input_host[i];
        if (value > threshold_f) {
            output_host[write_pos++] = value;
        }
    }

    cnrtMemcpy(output.data_ptr<float>(),
               output_host.data(),
               selected_count * sizeof(float),
               cnrtMemcpyHostToDev);
    return output;
}
