#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>
#include <vector>

torch::Tensor bang_func(torch::Tensor input_log_prob, torch::Tensor target_prob) {
    TORCH_CHECK(input_log_prob.dim() == 2 && target_prob.dim() == 2,
                "Both inputs must be 2D tensors [batch, N]");
    TORCH_CHECK(input_log_prob.size(0) == target_prob.size(0) &&
                input_log_prob.size(1) == target_prob.size(1),
                "Input shapes must match");

    auto input_contig = input_log_prob.contiguous().to(torch::kFloat32);
    auto target_contig = target_prob.contiguous().to(torch::kFloat32);

    const int64_t batch = input_contig.size(0);
    const int64_t total = input_contig.numel();

    std::vector<float> input_host(total);
    std::vector<float> target_host(total);
    cnrtMemcpy(input_host.data(),
               input_contig.data_ptr<float>(),
               total * sizeof(float),
               cnrtMemcpyDevToHost);
    cnrtMemcpy(target_host.data(),
               target_contig.data_ptr<float>(),
               total * sizeof(float),
               cnrtMemcpyDevToHost);

    float total_sum = 0.0f;
    for (int64_t i = 0; i < total; ++i) {
        float t = target_host[i];
        if (t > 0.0f) {
            total_sum += t * (logf(t) - input_host[i]);
        }
    }

    float result_host = total_sum / static_cast<float>(batch);
    auto output = torch::empty({}, input_contig.options());
    cnrtMemcpy(output.data_ptr<float>(),
               &result_host,
               sizeof(float),
               cnrtMemcpyHostToDev);
    return output;
}
