#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>
#include <math.h>


#define DOT_CHUNK 256

__mlu_entry__ void gru_step_kernel(
    c10::Half *seq_input,
    c10::Half *h_prev,
    c10::Half *weight_ih,
    int weight_ih_width,
    c10::Half *weight_hh,
    c10::Half *bias_ih,
    c10::Half *bias_hh,
    c10::Half *h_next,
    c10::Half *seq_output,
    int batch,
    int seq_len,
    int step,
    int input_width,
    int hidden_size) {
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = batch / core_num;
    uint32_t remainder = batch % core_num;
    uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core + (core_id < remainder ? 1 : 0);

    __nram__ half x_buf[DOT_CHUNK];
    __nram__ half h_buf[DOT_CHUNK];
    __nram__ half w_buf[DOT_CHUNK];
    __nram__ half mul_buf[DOT_CHUNK];
    __nram__ half sum_buf[DOT_CHUNK];
    __nram__ half prev_half;
    __nram__ half out_half;
    __nram__ half bias_half;

    for (uint32_t b = start; b < start + count; ++b) {
        c10::Half *x_ptr = seq_input + (b * seq_len + step) * input_width;
        c10::Half *h_prev_ptr = h_prev + b * hidden_size;
        c10::Half *h_next_ptr = h_next + b * hidden_size;
        c10::Half *seq_out_ptr = seq_output + (b * seq_len + step) * hidden_size;

        for (int h = 0; h < hidden_size; ++h) {
            float r_x = 0.0f;
            float z_x = 0.0f;
            float n_x = 0.0f;
            float r_h = 0.0f;
            float z_h = 0.0f;
            float n_h = 0.0f;

            for (int off = 0; off < input_width; off += DOT_CHUNK) {
                int len = (off + DOT_CHUNK <= input_width) ? DOT_CHUNK : (input_width - off);
                int aligned_len = (len + 63) & ~63;

                __memcpy(x_buf, x_ptr + off, len * sizeof(half), GDRAM2NRAM);
                if (aligned_len > len) {
                    __bang_write_zero(x_buf + len, aligned_len - len);
                }

                __memcpy(w_buf,
                         weight_ih + h * weight_ih_width + off,
                         len * sizeof(half),
                         GDRAM2NRAM);
                if (aligned_len > len) {
                    __bang_write_zero(w_buf + len, aligned_len - len);
                }
                __bang_mul(mul_buf, x_buf, w_buf, aligned_len);
                __bang_reduce_sum(sum_buf, mul_buf, aligned_len);
                r_x += (float)sum_buf[0];

                __memcpy(w_buf,
                         weight_ih + (hidden_size + h) * weight_ih_width + off,
                         len * sizeof(half),
                         GDRAM2NRAM);
                if (aligned_len > len) {
                    __bang_write_zero(w_buf + len, aligned_len - len);
                }
                __bang_mul(mul_buf, x_buf, w_buf, aligned_len);
                __bang_reduce_sum(sum_buf, mul_buf, aligned_len);
                z_x += (float)sum_buf[0];

                __memcpy(w_buf,
                         weight_ih + (2 * hidden_size + h) * weight_ih_width + off,
                         len * sizeof(half),
                         GDRAM2NRAM);
                if (aligned_len > len) {
                    __bang_write_zero(w_buf + len, aligned_len - len);
                }
                __bang_mul(mul_buf, x_buf, w_buf, aligned_len);
                __bang_reduce_sum(sum_buf, mul_buf, aligned_len);
                n_x += (float)sum_buf[0];
            }

            for (int off = 0; off < hidden_size; off += DOT_CHUNK) {
                int len = (off + DOT_CHUNK <= hidden_size) ? DOT_CHUNK : (hidden_size - off);
                int aligned_len = (len + 63) & ~63;

                __memcpy(h_buf, h_prev_ptr + off, len * sizeof(half), GDRAM2NRAM);
                if (aligned_len > len) {
                    __bang_write_zero(h_buf + len, aligned_len - len);
                }

                __memcpy(w_buf,
                         weight_hh + h * hidden_size + off,
                         len * sizeof(half),
                         GDRAM2NRAM);
                if (aligned_len > len) {
                    __bang_write_zero(w_buf + len, aligned_len - len);
                }
                __bang_mul(mul_buf, h_buf, w_buf, aligned_len);
                __bang_reduce_sum(sum_buf, mul_buf, aligned_len);
                r_h += (float)sum_buf[0];

                __memcpy(w_buf,
                         weight_hh + (hidden_size + h) * hidden_size + off,
                         len * sizeof(half),
                         GDRAM2NRAM);
                if (aligned_len > len) {
                    __bang_write_zero(w_buf + len, aligned_len - len);
                }
                __bang_mul(mul_buf, h_buf, w_buf, aligned_len);
                __bang_reduce_sum(sum_buf, mul_buf, aligned_len);
                z_h += (float)sum_buf[0];

                __memcpy(w_buf,
                         weight_hh + (2 * hidden_size + h) * hidden_size + off,
                         len * sizeof(half),
                         GDRAM2NRAM);
                if (aligned_len > len) {
                    __bang_write_zero(w_buf + len, aligned_len - len);
                }
                __bang_mul(mul_buf, h_buf, w_buf, aligned_len);
                __bang_reduce_sum(sum_buf, mul_buf, aligned_len);
                n_h += (float)sum_buf[0];
            }

            __memcpy(&bias_half, bias_ih + h, sizeof(half), GDRAM2NRAM);
            float r = r_x + (float)bias_half;
            __memcpy(&bias_half, bias_hh + h, sizeof(half), GDRAM2NRAM);
            r += r_h + (float)bias_half;
            r = 1.0f / (1.0f + expf(-r));

            __memcpy(&bias_half, bias_ih + hidden_size + h, sizeof(half), GDRAM2NRAM);
            float z = z_x + (float)bias_half;
            __memcpy(&bias_half, bias_hh + hidden_size + h, sizeof(half), GDRAM2NRAM);
            z += z_h + (float)bias_half;
            z = 1.0f / (1.0f + expf(-z));

            __memcpy(&bias_half, bias_ih + 2 * hidden_size + h, sizeof(half), GDRAM2NRAM);
            float n_val = n_x + (float)bias_half;
            __memcpy(&bias_half, bias_hh + 2 * hidden_size + h, sizeof(half), GDRAM2NRAM);
            n_val = tanhf(n_val + r * (n_h + (float)bias_half));

            __memcpy(&prev_half, h_prev_ptr + h, sizeof(half), GDRAM2NRAM);
            float prev = (float)prev_half;
            out_half = (half)((1.0f - z) * n_val + z * prev);

            __memcpy(h_next_ptr + h, &out_half, sizeof(half), NRAM2GDRAM);
            __memcpy(seq_out_ptr + h, &out_half, sizeof(half), NRAM2GDRAM);
        }
    }
}

// ============================================================
// 包装函数：签名必须匹配评估脚本（init 参数全部展开）
//   forward x        : 1 个 Tensor
//   init 权重(8 个)  : weight_ih_l0/weight_hh_l0/bias_ih_l0/bias_hh_l0/
//                      weight_ih_l1/weight_hh_l1/bias_ih_l1/bias_hh_l1
//   init 标量(3 个)  : input_size, hidden_size, num_layers
// ============================================================
torch::Tensor bang_func(torch::Tensor x,
                        torch::Tensor weight_ih_l0,
                        torch::Tensor weight_hh_l0,
                        torch::Tensor bias_ih_l0,
                        torch::Tensor bias_hh_l0,
                        torch::Tensor weight_ih_l1,
                        torch::Tensor weight_hh_l1,
                        torch::Tensor bias_ih_l1,
                        torch::Tensor bias_hh_l1,
                        int input_size,
                        int hidden_size,
                        int num_layers) {
    TORCH_CHECK(num_layers == 2, "this kernel only supports num_layers == 2 (per problem spec)");
    TORCH_CHECK(hidden_size > 0 && input_size > 0, "input/hidden size must be positive");

    auto x_contig    = x.contiguous().to(torch::kFloat16);
    auto w_ih_l0_c   = weight_ih_l0.contiguous().to(torch::kFloat16);
    auto w_hh_l0_c   = weight_hh_l0.contiguous().to(torch::kFloat16);
    auto b_ih_l0_c   = bias_ih_l0.contiguous().to(torch::kFloat16);
    auto b_hh_l0_c   = bias_hh_l0.contiguous().to(torch::kFloat16);
    auto w_ih_l1_c   = weight_ih_l1.contiguous().to(torch::kFloat16);
    auto w_hh_l1_c   = weight_hh_l1.contiguous().to(torch::kFloat16);
    auto b_ih_l1_c   = bias_ih_l1.contiguous().to(torch::kFloat16);
    auto b_hh_l1_c   = bias_hh_l1.contiguous().to(torch::kFloat16);

    TORCH_CHECK(x_contig.dim() == 3, "x must be 3-D [batch, seq_len, input_size]");
    const int batch   = x_contig.size(0);
    const int seq_len = x_contig.size(1);
    TORCH_CHECK(x_contig.size(2) == input_size, "x last dim must equal input_size");

    // 形状校验
    TORCH_CHECK(w_ih_l0_c.dim() == 2 && w_ih_l0_c.size(0) == 3 * hidden_size
                && w_ih_l0_c.size(1) == input_size, "weight_ih_l0 shape mismatch");
    TORCH_CHECK(w_hh_l0_c.dim() == 2 && w_hh_l0_c.size(0) == 3 * hidden_size
                && w_hh_l0_c.size(1) == hidden_size, "weight_hh_l0 shape mismatch");
    TORCH_CHECK(w_ih_l1_c.dim() == 2 && w_ih_l1_c.size(0) == 3 * hidden_size
                && w_ih_l1_c.size(1) == hidden_size, "weight_ih_l1 shape mismatch");
    TORCH_CHECK(w_hh_l1_c.dim() == 2 && w_hh_l1_c.size(0) == 3 * hidden_size
                && w_hh_l1_c.size(1) == hidden_size, "weight_hh_l1 shape mismatch");
    TORCH_CHECK(b_ih_l0_c.numel() == 3 * hidden_size, "bias_ih_l0 size mismatch");
    TORCH_CHECK(b_hh_l0_c.numel() == 3 * hidden_size, "bias_hh_l0 size mismatch");
    TORCH_CHECK(b_ih_l1_c.numel() == 3 * hidden_size, "bias_ih_l1 size mismatch");
    TORCH_CHECK(b_hh_l1_c.numel() == 3 * hidden_size, "bias_hh_l1 size mismatch");

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid_dim = {16, 1, 1};

    torch::Tensor cur_input = x_contig;
    torch::Tensor cur_output;

    for (int layer = 0; layer < num_layers; ++layer) {
        int cur_input_size = (layer == 0) ? input_size : hidden_size;

        c10::Half *layer_w_ih = (layer == 0) ? w_ih_l0_c.data_ptr<c10::Half>()
                                              : w_ih_l1_c.data_ptr<c10::Half>();
        c10::Half *layer_w_hh = (layer == 0) ? w_hh_l0_c.data_ptr<c10::Half>()
                                              : w_hh_l1_c.data_ptr<c10::Half>();
        c10::Half *layer_b_ih = (layer == 0) ? b_ih_l0_c.data_ptr<c10::Half>()
                                              : b_ih_l1_c.data_ptr<c10::Half>();
        c10::Half *layer_b_hh = (layer == 0) ? b_hh_l0_c.data_ptr<c10::Half>()
                                              : b_hh_l1_c.data_ptr<c10::Half>();
        int weight_ih_width = cur_input_size;

        cur_output = torch::empty({batch, seq_len, hidden_size}, x_contig.options());
        auto h_prev = torch::zeros({batch, hidden_size}, x_contig.options());
        auto h_next = torch::empty({batch, hidden_size}, x_contig.options());

        for (int step = 0; step < seq_len; ++step) {
            gru_step_kernel<<<grid_dim, cnrtFuncTypeUnion1, queue>>>(
                cur_input.data_ptr<c10::Half>(),
                h_prev.data_ptr<c10::Half>(),
                layer_w_ih,
                weight_ih_width,
                layer_w_hh,
                layer_b_ih,
                layer_b_hh,
                h_next.data_ptr<c10::Half>(),
                cur_output.data_ptr<c10::Half>(),
                batch,
                seq_len,
                step,
                cur_input_size,
                hidden_size
            );

            torch::Tensor tmp = h_prev;
            h_prev = h_next;
            h_next = tmp;
        }

        cur_input = cur_output;
    }

    cnrtQueueSync(queue);
    return cur_output;
}
