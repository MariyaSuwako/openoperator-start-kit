#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

// 前向声明
__mlu_entry__ void conv_transpose1d_kernel(
    float *x, float *weight, float *bias, float *output,
    int N, int C_in, int C_out, int L_in,
    int K, int stride, int padding, int output_padding, int groups,
    int L_out);

// ---------- 包装函数 ----------
torch::Tensor bang_func(torch::Tensor x,
                        torch::Tensor kernel,
                        int in_channels,
                        int out_channels,
                        int kernel_size,
                        int stride,
                        int padding,
                        int output_padding,
                        int groups,
                        bool bias) {
    auto x_contig = x.contiguous().to(torch::kFloat32);
    auto k_contig = kernel.contiguous().to(torch::kFloat32);

    TORCH_CHECK(x_contig.dim() == 3, "x must be 3-D (N, C_in, L)");
    TORCH_CHECK(k_contig.dim() == 3, "kernel must be 3-D (C_in, C_out/groups, K)");

    const int N    = x_contig.size(0);
    const int C_in = x_contig.size(1);
    const int L_in = x_contig.size(2);
    const int K    = k_contig.size(2);
    const int C_out_from_kernel = k_contig.size(1) * groups; // 实际输出通道数

    TORCH_CHECK(C_in == in_channels, "in_channels mismatch");
    TORCH_CHECK(K == kernel_size, "kernel_size mismatch");
    TORCH_CHECK(in_channels % groups == 0, "in_channels must be divisible by groups");
    TORCH_CHECK(out_channels % groups == 0, "out_channels must be divisible by groups");
    TORCH_CHECK(C_out_from_kernel == out_channels, "out_channels mismatch with kernel shape");
    TORCH_CHECK(k_contig.size(0) == C_in, "kernel shape[0] must equal in_channels");

    // 输出长度公式 (dilation = 1)
    int L_out = (L_in - 1) * stride - 2 * padding + K + output_padding;
    TORCH_CHECK(L_out > 0, "Invalid output length");

    auto output = torch::empty({N, out_channels, L_out}, x_contig.options());

    // 偏置准备
    torch::Tensor bias_tensor;
    float *bias_ptr = nullptr;
    if (bias) {
        bias_tensor = torch::zeros({out_channels}, x_contig.options());
        bias_ptr = bias_tensor.data_ptr<float>();
    }

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid_dim = {16, 1, 1};

    conv_transpose1d_kernel<<<grid_dim, cnrtFuncTypeUnion1, queue>>>(
        x_contig.data_ptr<float>(),
        k_contig.data_ptr<float>(),
        bias_ptr,
        output.data_ptr<float>(),
        N, C_in, out_channels, L_in,
        K, stride, padding, output_padding, groups,
        L_out
    );
    cnrtQueueSync(queue);

    return output;
}

// ---------- 转置1D卷积核函数 ----------
__mlu_entry__ void conv_transpose1d_kernel(
    float *x, float *weight, float *bias, float *output,
    int N, int C_in, int C_out, int L_in,
    int K, int stride, int padding, int output_padding, int groups,
    int L_out) {

    uint32_t total_outs = (uint32_t)N * C_out * L_out;
    uint32_t core_id    = taskId;
    uint32_t core_num   = taskDim;
    uint32_t per_core   = total_outs / core_num;
    uint32_t remainder  = total_outs % core_num;
    uint32_t start      = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t count      = per_core + (core_id < remainder ? 1 : 0);

    int C_in_per_group  = C_in / groups;
    int C_out_per_group = C_out / groups;

    // 所有参与 __memcpy 的标量必须为 __nram__
    __nram__ float x_val;
    __nram__ float w_val;
    __nram__ float accum;
    __nram__ float b_val;

    for (uint32_t idx = start; idx < start + count; ++idx) {
        // 解码输出坐标 (n, oc, ox)
        int tmp = (int)idx;
        int ox  = tmp % L_out;  tmp /= L_out;
        int oc  = tmp % C_out;  tmp /= C_out;
        int n   = tmp;

        accum = 0.0f;

        int group_id = oc / C_out_per_group;
        int oc_local = oc % C_out_per_group;
        int ic_start = group_id * C_in_per_group;
        int ic_end   = ic_start + C_in_per_group;

        // 遍历 kernel 位置 k，推导输入位置 ix
        for (int k = 0; k < K; ++k) {
            // ix * stride + k - padding = ox  =>  ix = (ox + padding - k) / stride
            int val = ox + padding - k;
            if (val % stride != 0) continue;
            int ix = val / stride;
            if (ix < 0 || ix >= L_in) continue;

            // 对于所有组内输入通道累加
            for (int ic = ic_start; ic < ic_end; ++ic) {
                // 加载 x[n, ic, ix]
                int x_off = ((n * C_in + ic) * L_in) + ix;
                __memcpy(&x_val, x + x_off, sizeof(float), GDRAM2NRAM);

                // 加载 weight[ic, oc_local, k]
                int w_off = ((ic * C_out_per_group) + oc_local) * K + k;
                __memcpy(&w_val, weight + w_off, sizeof(float), GDRAM2NRAM);

                accum += x_val * w_val;
            }
        }

        if (bias != nullptr) {
            __memcpy(&b_val, bias + oc, sizeof(float), GDRAM2NRAM);
            accum += b_val;
        }

        __memcpy(output + idx, &accum, sizeof(float), NRAM2GDRAM);
    }
}