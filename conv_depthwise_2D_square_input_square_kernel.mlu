#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>
#include <cstdint>

// 核函数内部使用的最大 K*K 尺寸（对齐到 32）
#define MAX_K2_ALIGNED 1024

/**
 * @brief 深度可分离卷积的逐通道卷积核函数（BangC）
 *
 * 输入：
 *   x       : [N, C, H, W] 特征图，float32
 *   weight  : [C, 1, K, K] 卷积核，float32
 *   bias    : [C] 偏置，可为 nullptr
 *   output  : [N, C, H_out, W_out] 输出，float32
 * 标量参数：
 *   N, C, H, W, K, stride, padding, H_out, W_out
 */
__mlu_entry__ void depthwise_conv2d_kernel(
    float *x,
    float *weight,
    float *bias,
    float *output,
    int N, int C, int H, int W,
    int K, int stride, int padding,
    int H_out, int W_out)
{
    // 1. 多核任务拆分
    uint32_t core_id   = taskId;
    uint32_t core_num  = taskDim;
    uint32_t total_outs = (uint32_t)N * C * H_out * W_out;
    uint32_t per_core  = total_outs / core_num;
    uint32_t remainder = total_outs % core_num;
    uint32_t start     = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t count     = per_core + (core_id < remainder ? 1 : 0);

    // 2. NRAM 缓冲区声明
    // 输入窗口、权重副本、临时乘积、求和缓冲区
    __nram__ float input_win[MAX_K2_ALIGNED];
    __nram__ float weight_k[MAX_K2_ALIGNED];
    __nram__ float temp_mul[MAX_K2_ALIGNED];
    __nram__ float sum_buf[MAX_K2_ALIGNED];

    int K2          = K * K;
    int aligned_K2  = (K2 + 31) & ~31;   // 向上对齐到 32 的倍数

    // 3. 逐个输出点循环
    for (uint32_t idx = start; idx < start + count; ++idx) {
        // 将线性索引解码为 [n, c, oh, ow]
        int tmp = (int)idx;
        int ow  = tmp % W_out;  tmp /= W_out;
        int oh  = tmp % H_out;  tmp /= H_out;
        int c   = tmp % C;      tmp /= C;
        int n   = tmp;          // batch index

        // 3.1 计算输入窗口起始位置（带 padding）
        int h_start = (int)oh * stride - padding;
        int w_start = (int)ow * stride - padding;

        // 3.2 加载输入窗口到 NRAM，边界外填 0
        __bang_write_zero(input_win, aligned_K2);
        for (int kh = 0; kh < K; ++kh) {
            int in_h = h_start + kh;
            if (in_h < 0 || in_h >= H) continue;   // 垂直方向填充 0
            for (int kw = 0; kw < K; ++kw) {
                int in_w = w_start + kw;
                if (in_w < 0 || in_w >= W) continue; // 水平方向填充 0
                // 计算 x 中对应元素的全局偏移
                int x_offset = ((n * C + c) * H + in_h) * W + in_w;
                // 拷贝单个 float 到输入窗口的对应位置
                __memcpy(input_win + kh * K + kw, x + x_offset, sizeof(float), GDRAM2NRAM);
            }
        }

        // 3.3 加载当前通道的卷积核到 NRAM
        __memcpy(weight_k, weight + c * K2, K2 * sizeof(float), GDRAM2NRAM);
        // 将尾部补齐区域置零（保证乘加运算安全）
        if (aligned_K2 > K2) {
            __bang_write_zero(weight_k + K2, aligned_K2 - K2);
        }

        // 3.4 逐元素乘法 + 归约求和得到卷积结果
        __bang_mul(temp_mul, input_win, weight_k, aligned_K2);
        __bang_reduce_sum(sum_buf, temp_mul, aligned_K2);
        float result = sum_buf[0];

        // 3.5 加上偏置（如果存在）
        if (bias != nullptr) {
            float b_val;
            __memcpy(&b_val, bias + c, sizeof(float), GDRAM2NRAM);
            result += b_val;
        }

        // 3.6 将结果写回全局内存
        __memcpy(output + idx, &result, sizeof(float), NRAM2GDRAM);
    }
}

/**
 * @brief PyTorch 扩展接口
 *
 * @param x       输入张量 [N, C, H, W]
 * @param weight  权重张量 [C, 1, K, K]
 * @param bias    可选偏置 [C]
 * @param stride  步长（标量）
 * @param padding 填充（标量，对称填充）
 * @return        输出张量 [N, C, H_out, W_out]
 */
torch::Tensor depthwise_conv2d_bang(
    torch::Tensor x,
    torch::Tensor weight,
    c10::optional<torch::Tensor> bias,
    int stride,
    int padding)
{
    // 参数合法性检查
    TORCH_CHECK(x.dim() == 4,       "x must be 4-D (N, C, H, W)");
    TORCH_CHECK(weight.dim() == 4,  "weight must be 4-D (C, 1, K, K)");
    TORCH_CHECK(x.size(1) == weight.size(0), "Channel mismatch between x and weight");
    TORCH_CHECK(weight.size(1) == 1, "weight second dim must be 1 for depthwise");

    // 确保内存连续并转为 float32
    auto x_contig      = x.contiguous().to(torch::kFloat32);
    auto weight_contig = weight.contiguous().to(torch::kFloat32);

    const int N = x_contig.size(0);
    const int C = x_contig.size(1);
    const int H = x_contig.size(2);
    const int W = x_contig.size(3);
    const int K = weight_contig.size(2);   // kernel size

    // 计算输出尺寸
    int H_out = (H + 2 * padding - K) / stride + 1;
    int W_out = (W + 2 * padding - K) / stride + 1;

    TORCH_CHECK(H_out > 0 && W_out > 0, "Invalid output dimensions");

    auto output = torch::empty({N, C, H_out, W_out}, x_contig.options());

    // 可选偏置
    float *bias_ptr = nullptr;
    if (bias.has_value()) {
        auto bias_contig = bias->contiguous().to(torch::kFloat32);
        TORCH_CHECK(bias_contig.size(0) == C, "Bias size must equal C");
        bias_ptr = bias_contig.data_ptr<float>();
    }

    // 启动 MLU 核函数（这里以 16 个计算核为例）
    cnrtDim3_t grid_dim  = {16, 1, 1};
    cnrtFuncType1_t func_type = cnrtFuncTypeUnion1;
    cnrtQueue_t queue    = torch_mlu::getCurMLUStream();

    depthwise_conv2d_kernel<<<grid_dim, func_type, queue>>>(
        x_contig.data_ptr<float>(),
        weight_contig.data_ptr<float>(),
        bias_ptr,
        output.data_ptr<float>(),
        N, C, H, W,
        K, stride, padding,
        H_out, W_out
    );

    // 同步流，确保结果完成
    cnrtQueueSync(queue);

    return output;
}

