#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define MAX_DIM 2048
#define MAX_K   256

__mlu_entry__ void topk_kernel(const float* x, float* out_vals, int64_t* out_idx,
                               int batch, int dim, int k) {
    int row = taskId;
    if (row >= batch) return;

    __nram__ float vals[MAX_DIM];
    __nram__ int   idxs[MAX_DIM];

    // 加载整行到 NRAM
    __memcpy(vals, x + row * dim, dim * sizeof(float), GDRAM2NRAM);
    for (int j = 0; j < dim; ++j) idxs[j] = j;

    // 选择排序（降序），仅排前 k 个
    for (int i = 0; i < k; ++i) {
        int max_pos = i;
        float max_val = vals[i];
        for (int j = i + 1; j < dim; ++j) {
            if (vals[j] > max_val) {
                max_val = vals[j];
                max_pos = j;
            }
        }
        if (max_pos != i) {
            // 交换值
            float tmp_val = vals[i];
            vals[i] = vals[max_pos];
            vals[max_pos] = tmp_val;
            // 交换索引
            int tmp_idx = idxs[i];
            idxs[i] = idxs[max_pos];
            idxs[max_pos] = tmp_idx;
        }
    }

    // 直接赋值写回（不要使用 __memcpy）
    for (int i = 0; i < k; ++i) {
        out_vals[row * k + i] = vals[i];
        out_idx[row * k + i] = idxs[i];
    }
}

std::vector<torch::Tensor> bang_func(torch::Tensor x, int k, int dim) {
    // 简化：仅支持 2D 且 dim=1
    TORCH_CHECK(x.dim() == 2, "Only 2D tensor [batch, dim] is supported");
    TORCH_CHECK(dim == 1, "Only dim=1 (columns) is supported");
    
    auto x_contig = x.contiguous().to(torch::kFloat32);
    int batch = x_contig.size(0);
    int dim_size = x_contig.size(1);
    
    TORCH_CHECK(k <= dim_size, "k must be <= dim_size");
    TORCH_CHECK(k <= MAX_K, "k exceeds MAX_K (", MAX_K, ")");
    TORCH_CHECK(dim_size <= MAX_DIM, "dim exceeds MAX_DIM (", MAX_DIM, ")");

    auto values = torch::empty({batch, k}, x_contig.options());
    auto indices = torch::empty({batch, k}, x_contig.options().dtype(torch::kLong));

    // 显式转换为 unsigned int 避免编译警告
    cnrtDim3_t grid_dim = {static_cast<unsigned int>(batch), 1, 1};
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    topk_kernel<<<grid_dim, cnrtFuncTypeUnion1, queue>>>(
        x_contig.data_ptr<float>(),
        values.data_ptr<float>(),
        indices.data_ptr<int64_t>(),
        batch, dim_size, k
    );

    cnrtQueueSync(queue);
    return {values, indices};
}
