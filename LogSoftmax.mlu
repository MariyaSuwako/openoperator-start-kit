#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>

#define CHUNK_SIZE 32768

__mlu_entry__ void leakyrelu_kernel(c10::Half *input, c10::Half *output, int total) {
    // 多核拆分参数
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = total / core_num;
    uint32_t remainder = total % core_num;
    uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core + (core_id < remainder ? 1 : 0);

    // NRAM 空间分配
    __nram__ half nram_input[CHUNK_SIZE];
    __nram__ half nram_sum[CHUNK_SIZE];
    __nram__ half nram_output[CHUNK_SIZE];

    for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
        uint32_t len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : (count - offset);
        uint32_t aligned_len = (len + 63) & ~63;
        __memcpy(nram_input, input + start + offset, len * sizeof(c10::Half), GDRAM2NRAM);
        __bang_reduce_sum(nram_sum, nram_input, aligned_len);
        __bang_reduce_sum(nram_sum, nram_sum, aligned_len);
        half avg = nram_sum[0] / aligned_len;
        __bang_sub_scalar(nram_input, nram_input, avg, aligned_len);
        __bang_active_exp(nram_output, nram_input, aligned_len);
        __bang_reduce_sum(nram_sum, nram_input, aligned_len);
        __bang_reduce_sum(nram_sum, nram_sum, aligned_len);
        half sum = log(nram_sum[0]);
        __bang_sub_scalar(nram_output, nram_input, sum, aligned_len);
        __memcpy(output + start + offset, nram_output, len * sizeof(half), NRAM2GDRAM);
    }
}

torch::Tensor bang_func(torch::Tensor A, int dim) {
    TORCH_CHECK(A.is_contiguous(), "Input must be contiguous");
    auto B = torch::empty_like(A);
    int total = A.numel();
    int batch = total/dim;
    leakyrelu_kernel<<<(cnrtDim3_t){batch, 1, 1}, cnrtFuncTypeUnion1, torch_mlu::getCurMLUStream()>>>(
        A.data_ptr<c10::Half>(),
        B.data_ptr<c10::Half>(),
        total
    );

    return B;
}//abc