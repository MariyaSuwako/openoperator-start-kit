#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>

#define CHUNK_SIZE 16384

__mlu_entry__ void leakyrelu_kernel(float *input, float *output, int total) {
    // 多核拆分参数
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = total / core_num;
    uint32_t remainder = total % core_num;
    uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core + (core_id < remainder ? 1 : 0);

    // NRAM 空间分配
    __nram__ float nram_input[CHUNK_SIZE];
    __nram__ float nram_sum[CHUNK_SIZE];
    __nram__ float nram_output[CHUNK_SIZE];

    for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
        uint32_t len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : (count - offset);
        uint32_t aligned_len = (len + 63) & ~63;
        __memcpy(nram_input, input + start + offset, len * sizeof(float), GDRAM2NRAM);
        //__bang_maxpool(nram_sum, nram_input, 1, len, 1, len, 1, 1, 1);
        //float maximum = nram_sum[0];
        //__bang_sub_scalar(nram_input, nram_input, maximum, len);
        __bang_active_exp(nram_output, nram_input, len);
        __bang_sumpool(nram_sum, nram_output, 1, len, 1, len, 1, 1, 1);
        __bang_sub_scalar(nram_output, nram_input, (float)log((double)nram_sum[0]), len);
        __memcpy(output + start + offset, nram_output, len * sizeof(float), NRAM2GDRAM);
    }
}

torch::Tensor bang_func(torch::Tensor A, int dim) {
    TORCH_CHECK(A.is_contiguous(), "Input must be contiguous");
    A = A.to(torch::kFloat32);
    auto B = torch::empty_like(A);
    int total = A.numel();
    unsigned int temp = A.sizes()[0];
    leakyrelu_kernel<<<(cnrtDim3_t){16, 1, 1}, cnrtFuncTypeUnion1, torch_mlu::getCurMLUStream()>>>(
        A.data_ptr<float>(),
        B.data_ptr<float>(),
        total
    );
    return B.to(torch::kFloat16);
}//abc